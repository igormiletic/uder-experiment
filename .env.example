# Copy to .env and fill in, then load with:  set -a; source .env; set +a
# Only needed for `uder-experiment run --use-real-ai`.
AI_API_KEY=
# Optional: any OpenAI-compatible endpoint (default: OpenAI)
AI_API_BASE_URL=
# Optional: model name (default: gpt-4o-mini)
AI_MODEL=gpt-4o-mini
# Optional: minimum seconds between LLM calls (default: 5)
AI_MIN_INTERVAL_SECONDS=5
# Optional: per-call timeout in seconds (default: 60)
AI_REQUEST_TIMEOUT_SECONDS=60
